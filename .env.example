# MongoDB connection string. Leave unset to run in Demo mode
# (in-memory store, seeded lazily, resets on server restart).
# Example: mongodb://localhost:27017
# MONGODB_URI=

# Database name used when MONGODB_URI is set.
MONGODB_DB_NAME=c_programming_lab

# Secret used to sign session cookies (HMAC-SHA256).
# REQUIRED in production. If unset, a demo fallback secret is used.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# Judge0 API for real C code execution (optional; playground falls back
# to demo execution mode when unset).
# JUDGE0_API_URL=
# JUDGE0_API_KEY=

# Execution mode for the code playground: "demo" (simulated) or "judge0" (real).
EXECUTION_MODE=demo

# Dev-only: base URL for scripts/screenshots.mjs (defaults to http://localhost:3000)
# BASE_URL=
